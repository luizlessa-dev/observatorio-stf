{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.observatoriodostf.org"
        }
      ],
      "destination": "https://observatoriodostf.org/$1",
      "permanent": true
    },
    { "source": "/apoia", "destination": "/assinar", "permanent": false },
    { "source": "/contato", "destination": "/sobre#correcao", "permanent": false },
    { "source": "/direito-de-resposta", "destination": "/sobre#correcao", "permanent": false },
    { "source": "/equipe", "destination": "/sobre#quem-mantem", "permanent": false },
    { "source": "/governanca", "destination": "/sobre#quem-mantem", "permanent": false },
    { "source": "/como-apuramos", "destination": "/metodologia", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(self)"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://redggdtakzmsabwvjzhb.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(robots.txt|llms.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "framework": "astro",
  "outputDirectory": "dist"
}
