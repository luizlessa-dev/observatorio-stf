# Astro expõe ao navegador apenas variáveis com prefixo PUBLIC_.
# São as mesmas credenciais anônimas de antes — o conteúdo do site é
# público e a proteção real está nas policies RLS, não em esconder a chave.
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Usados apenas nos scripts Python (não expor no frontend)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
