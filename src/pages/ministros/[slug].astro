---
/**
 * Página por ministro — o achado E5 da auditoria.
 *
 * O SPA fazia toda a navegação de ministros em estado do React dentro de uma
 * única rota. Não existia URL para citar num texto, para o STF responder, para
 * outro veículo referenciar ou para o buscador indexar. Agora são 33 páginas,
 * uma por ministro, geradas no build com os dados já dentro do HTML.
 */
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { carregarMinistros, carregarDecisoes, carregarGastos, carregarGastosServidores, carregarViagens, carregarControleConcentrado, carregarReclamacoes, carregarProximosJulgamentos, carregarOmissaoInconstitucional, carregarPerfilDecisorio } from "../../lib/dados";
import { fmtData, fmtDataCurta, fmtMes, fmtBRL, fmtNum } from "../../lib/formato";

export async function getStaticPaths() {
  const [ministros, todosCasos] = await Promise.all([carregarMinistros(), getCollection("casos")]);
  return Promise.all(
    ministros.map(async (m) => {
      const [{ decisoes, total, comoPresidente }, gastos, gastosServidores, viagens, controleConcentrado, reclamacoes, proximosJulgamentos, omissaoInconstitucional, perfil] = await Promise.all([
        carregarDecisoes(m.id),
        carregarGastos(m.id),
        carregarGastosServidores(m.id),
        carregarViagens(m.id),
        carregarControleConcentrado(m.id),
        carregarReclamacoes(m.id),
        carregarProximosJulgamentos(m.id),
        carregarOmissaoInconstitucional(m.id),
        carregarPerfilDecisorio(m.id),
      ]);
      const casos = todosCasos
        .filter((c) => c.data.ministros.includes(m.slug))
        .sort((a, b) => b.data.data_publicacao.localeCompare(a.data.data_publicacao));
      return { params: { slug: m.slug }, props: { m, decisoes, total, comoPresidente, gastos, gastosServidores, viagens, controleConcentrado, reclamacoes, proximosJulgamentos, omissaoInconstitucional, casos, perfil } };
    })
  );
}

const { m, decisoes, total, comoPresidente, gastos, gastosServidores, viagens, controleConcentrado, reclamacoes, proximosJulgamentos, omissaoInconstitucional, casos, perfil } = Astro.props;

const ROTULO_STATUS_CASO = { em_apuracao: "Em apuração", confirmado: "Confirmado", arquivado: "Arquivado" };

const ROTULO_NATUREZA = {
  merito: "Mérito",
  admissibilidade: "Admissibilidade",
  cautelar: "Cautelar",
  processual: "Processual",
  devolucao: "Devolução",
} as const;

const segmentosNatureza = perfil
  ? ([
      ["merito", perfil.pctMerito],
      ["admissibilidade", perfil.pctAdmissibilidade],
      ["cautelar", perfil.pctCautelar],
      ["processual", perfil.pctProcessual],
      ["devolucao", perfil.pctDevolucao],
    ] as const)
      .filter(([, pct]) => pct !== null && pct > 0)
      .map(([chave, pct]) => ({ chave, rotulo: ROTULO_NATUREZA[chave], pct: pct! }))
  : [];

const segmentosSentido = perfil
  ? ([
      ["favoravel", "Favorável", perfil.pctFavoravel],
      ["contrario", "Contrário", perfil.pctContrario],
      ["parcial", "Parcial", perfil.pctParcial],
    ] as const)
      .filter(([, , pct]) => pct !== null && pct > 0)
      .map(([chave, rotulo, pct]) => ({ chave, rotulo, pct: pct! }))
  : [];

const subsidio = gastos.find((g) => g.categoria === "subsidio_ministro");
const gabinete = gastos.find((g) => g.categoria === "custo_gabinete");
const gastoRef = subsidio ?? gabinete;
const totalMes = (subsidio?.valor ?? 0) + (gabinete?.valor ?? 0);
const servidores = gabinete?.descricao?.match(/\d+/)?.[0] ?? null;

const ROTULO_CARGO = { presidente: "Presidente do STF", vice_presidente: "Vice-presidente do STF" };

// Achado A6: a estrutura de apoio da Presidência não integra o gabinete do
// ministro, então o custo do presidente não é comparável ao dos demais.
const presidiaNoMesDoGasto = m.cargo === "presidente" && !!gastoRef;

const periodo = m.ativo
  ? `desde ${fmtData(m.data_posse)}`
  : `${fmtData(m.data_posse)} a ${fmtData(m.data_saida)}`;

// Só 3 mulheres já integraram o STF (Ellen Gracie, Cármen Lúcia, Rosa Weber)
// — lista estável e de conhecimento público, não uma coluna de banco que
// precise de pipeline pra 3 nomes que praticamente nunca mudam.
const MINISTRAS = new Set(["Ellen Gracie", "Cármen Lúcia", "Rosa Weber"]);
const ehMinistra = MINISTRAS.has(m.nome);
const substantivo = ehMinistra ? "ministra" : "ministro";
const artigoIndicado = ehMinistra ? "indicada" : "indicado";
const relatora = ehMinistra ? "relatora" : "relator";

const titulo = `${m.nome} — ${substantivo} do STF | Observatório do STF`;
const descricao = m.ativo
  ? `${m.nome} é ${substantivo} do STF desde ${fmtData(m.data_posse)}, ${artigoIndicado} por ${m.indicado_por}. ` +
    `${fmtNum(total)} decisões monocráticas como ${relatora}, custo de gabinete e aposentadoria compulsória.`
  : `${m.nome} foi ${substantivo} do STF de ${fmtData(m.data_posse)} a ${fmtData(m.data_saida)}, ` +
    `${artigoIndicado} por ${m.indicado_por}. ${fmtNum(total)} decisões monocráticas como ${relatora}.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: m.nome,
  jobTitle: m.ativo
    ? `${ehMinistra ? "Ministra" : "Ministro"} do Supremo Tribunal Federal`
    : `${ehMinistra ? "Ex-ministra" : "Ex-ministro"} do Supremo Tribunal Federal`,
  affiliation: { "@type": "GovernmentOrganization", name: "Supremo Tribunal Federal" },
  url: `https://observatoriodostf.org/ministros/${m.slug}`,
};
---
<Base titulo={titulo} descricao={descricao} caminho={`/ministros/${m.slug}`} jsonLd={jsonLd} imagemOg={`/og/ministros/${m.slug}.png`}>
  <div class="px-8 py-7 max-w-5xl">
    <nav class="text-[11px] text-subtle mb-[22px] flex items-center gap-[6px]">
      <a href="/ministros" class="hover:text-ink transition-colors">Ministros</a>
      <span class="text-border2">›</span>
      <span class="text-ink font-medium">{m.nome}</span>
    </nav>

    <div class="flex items-start gap-5 pb-6 border-b border-border mb-[22px]">
      <div class="w-[68px] h-[68px] rounded-full bg-surface border border-border2 flex items-center justify-center font-display text-[22px] font-bold text-muted flex-shrink-0">
        {m.iniciais_exibicao}
      </div>
      <div>
        <h1 class="font-display text-[26px] font-bold text-white leading-[1.2] mb-1">{m.nome}</h1>
        <div class="text-[12px] text-subtle mb-[10px]">
          {ehMinistra ? "Ministra" : "Ministro"} {periodo}
          {m.ativo && m.aposentadoria_comp && ` · Aposentadoria compulsória ${fmtData(m.aposentadoria_comp)}`}
        </div>
        <div class="flex gap-[5px] flex-wrap">
          {m.cargo && (
            <span class="text-[10px] font-semibold px-[9px] py-[3px] rounded-sm border border-white bg-white text-canvas">
              {ROTULO_CARGO[m.cargo]}
            </span>
          )}
          {!m.ativo && (
            <span class="text-[10px] font-medium px-[9px] py-[3px] rounded-sm border border-border2 text-subtle">
              Não está mais em exercício
            </span>
          )}
          <span class="text-[10px] font-medium px-[9px] py-[3px] rounded-sm border border-white/40 text-white">
            Indicado por {m.indicado_por}
          </span>
          <span class="text-[10px] font-medium px-[9px] py-[3px] rounded-sm border border-border2 text-muted">
            {m.partido_indicante}
          </span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 border border-border rounded-sm overflow-hidden mb-6">
      {[
        { rotulo: "Indicado por",   valor: m.indicado_por,                sub: m.partido_indicante },
        { rotulo: "Cargo anterior", valor: m.cargo_anterior ?? "—",       sub: `Governo ${m.indicado_por_curto}` },
        { rotulo: "Posse",          valor: fmtData(m.data_posse),         sub: "Data de posse no STF" },
        m.ativo
          ? { rotulo: "Aposentadoria", valor: fmtData(m.aposentadoria_comp), sub: "Compulsória aos 75 anos" }
          : { rotulo: "Saída",         valor: fmtData(m.data_saida),         sub: "Fim do exercício" },
      ].map((c, i) => (
        <div class:list={["px-4 py-[13px]", i < 3 && "md:border-r border-border"]}>
          <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">{c.rotulo}</div>
          <div class="text-[13px] font-semibold text-ink leading-snug">{c.valor}</div>
          <div class="text-[10px] text-subtle mt-[2px]">{c.sub}</div>
        </div>
      ))}
    </div>

    {casos.length > 0 && (
      <section class="border border-border rounded-sm overflow-hidden mb-6">
        <div class="px-4 py-[9px] bg-card border-b border-border">
          <h2 class="text-[9px] font-bold uppercase tracking-[1.5px] text-subtle">Casos relacionados</h2>
        </div>
        {casos.map((c) => (
          <a href={`/casos/${c.id}`} class="grid border-b border-border last:border-0 px-4 py-[9px] items-start gap-2 hover:bg-card transition-colors"
             style="grid-template-columns: 74px 1fr 90px">
            <time class="font-mono text-[9px] text-subtle pt-[1px]" datetime={c.data.data_publicacao}>
              {fmtDataCurta(c.data.data_publicacao)}
            </time>
            <div>
              <div class="text-[11px] text-ink font-medium leading-[1.35]">{c.data.titulo}</div>
              <div class="text-[10px] text-subtle leading-[1.35] line-clamp-1 mt-[2px]">{c.data.resumo}</div>
            </div>
            <span class:list={[
              "text-[9px] font-semibold uppercase tracking-[0.5px] px-[7px] py-[2px] rounded-sm text-right self-start justify-self-end",
              c.data.status === "confirmado" ? "bg-white text-canvas" : "border border-border2 text-subtle",
            ]}>
              {ROTULO_STATUS_CASO[c.data.status]}
            </span>
          </a>
        ))}
      </section>
    )}

    {proximosJulgamentos.length > 0 && (
      <section class="border border-border rounded-sm overflow-hidden mb-6">
        <div class="px-4 py-[9px] bg-card border-b border-border flex items-center justify-between gap-3">
          <h2 class="text-[9px] font-bold uppercase tracking-[1.5px] text-subtle">Próximos julgamentos</h2>
          <span class="text-[8.5px] text-subtle">{fmtNum(proximosJulgamentos.length)} na pauta</span>
        </div>
        {proximosJulgamentos.map((j) => (
          <div class="grid border-b border-border last:border-0 px-4 py-[9px] items-start gap-2" style="grid-template-columns: 90px 1fr 90px">
            <span class="text-[9px] font-mono text-subtle pt-[1px]">{j.classe} {j.numero}</span>
            <div>
              <div class="text-[11px] text-ink leading-[1.35]">{j.ramo_direito ?? "—"}</div>
              <div class="text-[9px] text-subtle mt-[2px]">
                {j.orgao}{j.papel === "vista" && " · pedido de vista"}
              </div>
            </div>
            <span class="text-[9px] text-subtle text-right self-start justify-self-end">
              {j.data_pauta ? fmtDataCurta(j.data_pauta) : "—"}
            </span>
          </div>
        ))}
        <p class="px-4 py-[8px] border-t border-border text-[9px] text-subtle leading-[1.5]">
          Fonte: portal de transparência do STF (painéis Corte Aberta — Pauta do Plenário e Pauta
          {" "}das Turmas). Processos já liberados para julgamento colegiado, ainda não julgados.
          {" "}"Pedido de vista" é quando o {substantivo} pediu mais tempo para analisar um processo
          relatado por outro ministro.
        </p>
      </section>
    )}

    {gastos.length > 0 && (
      <section class="border border-border rounded-sm overflow-hidden mb-6">
        <div class="px-4 py-[9px] bg-card border-b border-border flex items-center justify-between gap-3">
          <h2 class="text-[9px] font-bold uppercase tracking-[1.5px] text-subtle">Custo ao erário</h2>
          {gastoRef && <span class="text-[8.5px] text-subtle">dados até {fmtMes(gastoRef.mes, gastoRef.ano)}</span>}
        </div>
        <div class="grid grid-cols-3 divide-x divide-border">
          <div class="px-4 py-[13px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Subsídio</div>
            <div class="text-[15px] font-bold text-ink">{fmtBRL(subsidio?.valor ?? 0)}</div>
            <div class="text-[9px] text-subtle mt-[2px]">por mês</div>
          </div>
          <div class="px-4 py-[13px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Custo do gabinete</div>
            <div class="text-[15px] font-bold text-ink">{fmtBRL(gabinete?.valor ?? 0)}</div>
            <div class="text-[9px] text-subtle mt-[2px]">{servidores ? `${servidores} servidores` : "—"}</div>
          </div>
          <div class="px-4 py-[13px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Total mensal</div>
            <div class="text-[15px] font-bold text-white">{fmtBRL(totalMes)}</div>
            <div class="text-[9px] text-subtle mt-[2px]">ref. {gastoRef ? fmtMes(gastoRef.mes, gastoRef.ano) : "—"}</div>
          </div>
        </div>
        {gastosServidores.length > 0 && (
          <details class="border-t border-border group">
            <summary class="px-4 py-[9px] text-[10px] font-semibold text-ink cursor-pointer select-none list-none flex items-center gap-[6px] hover:bg-card/50 transition-colors">
              <span class="text-subtle group-open:rotate-90 transition-transform inline-block">›</span>
              Ver {gastosServidores.length} servidores do gabinete, nome a nome
            </summary>
            <div class="overflow-x-auto border-t border-border">
              <table class="w-full text-[10px]" style="min-width: 560px">
                <thead>
                  <tr class="bg-card/50 border-b border-border text-left">
                    <th class="px-4 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Nome</th>
                    <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Cargo</th>
                    <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Situação</th>
                    <th class="px-4 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px] text-right">Remuneração bruta</th>
                  </tr>
                </thead>
                <tbody>
                  {gastosServidores.map((s) => (
                    <tr class="border-b border-border last:border-0">
                      <td class="px-4 py-[6px] text-ink">{s.nome}</td>
                      <td class="px-3 py-[6px] text-muted">{s.cargo_comissionado ?? s.funcao ?? s.cargo_efetivo ?? "—"}</td>
                      <td class="px-3 py-[6px] text-subtle">{s.situacao_funcional ?? "—"}</td>
                      <td class="px-4 py-[6px] text-ink text-right font-mono">{fmtBRL(s.remuneracao_bruta)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="px-4 py-[8px] border-t border-border text-[9px] text-subtle leading-[1.5]">
              Fonte: portal de transparência do STF (rendimento_folha), referência {gastoRef ? fmtMes(gastoRef.mes, gastoRef.ano) : "—"}.
              {" "}A relação inclui o próprio {substantivo} — a linha de remuneração do titular do gabinete
              aparece junto com a da equipe, como consta na fonte original.
            </p>
          </details>
        )}

        {presidiaNoMesDoGasto && (
          <div class="px-4 py-[10px] border-t border-border bg-card/50">
            <p class="text-[10px] text-muted leading-[1.55]">
              <strong class="font-semibold text-ink">Não comparável ao dos demais gabinetes.</strong>
              {" "}{m.nome} presidia o STF na competência acima, e a estrutura de apoio da
              Presidência não integra o gabinete do ministro — parte da equipe que apareceria
              aqui está lotada na Presidência.
            </p>
          </div>
        )}
      </section>
    )}

    {(viagens.qtdPassagens > 0 || viagens.qtdDiarias > 0) && (
      <section class="border border-border rounded-sm overflow-hidden mb-6">
        <div class="px-4 py-[9px] bg-card border-b border-border flex items-center justify-between gap-3">
          <h2 class="text-[9px] font-bold uppercase tracking-[1.5px] text-subtle">Viagens a serviço</h2>
          {viagens.desde && <span class="text-[8.5px] text-subtle">dados desde {viagens.desde}</span>}
        </div>
        <div class="grid grid-cols-2 divide-x divide-border">
          <div class="px-4 py-[13px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Passagens aéreas</div>
            <div class="text-[15px] font-bold text-ink">{fmtBRL(viagens.totalPassagens)}</div>
            <div class="text-[9px] text-subtle mt-[2px]">{fmtNum(viagens.qtdPassagens)} trechos</div>
          </div>
          <div class="px-4 py-[13px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Diárias</div>
            <div class="text-[15px] font-bold text-ink">{fmtBRL(viagens.totalDiarias)}</div>
            <div class="text-[9px] text-subtle mt-[2px]">{fmtNum(viagens.qtdDiarias)} registros</div>
          </div>
        </div>

        {viagens.passagens.length > 0 && (
          <details class="border-t border-border group">
            <summary class="px-4 py-[9px] text-[10px] font-semibold text-ink cursor-pointer select-none list-none flex items-center gap-[6px] hover:bg-card/50 transition-colors">
              <span class="text-subtle group-open:rotate-90 transition-transform inline-block">›</span>
              Ver passagens mais recentes (até 40 de {fmtNum(viagens.qtdPassagens)})
            </summary>
            <div class="overflow-x-auto border-t border-border">
              <table class="w-full text-[10px]" style="min-width: 640px">
                <thead>
                  <tr class="bg-card/50 border-b border-border text-left">
                    <th class="px-4 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Nome</th>
                    <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Cargo</th>
                    <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Trecho</th>
                    <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Data ida</th>
                    <th class="px-4 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px] text-right">Custo efetivo</th>
                  </tr>
                </thead>
                <tbody>
                  {viagens.passagens.map((p) => (
                    <tr class="border-b border-border last:border-0">
                      <td class="px-4 py-[6px] text-ink">{p.nome ?? "—"}</td>
                      <td class="px-3 py-[6px] text-muted">{p.cargo ?? "—"}</td>
                      <td class="px-3 py-[6px] text-subtle">
                        {p.trecho ?? "—"}
                        {p.tipo_passagem === "Internacional" && <span class="text-[8px] text-subtle">{" "}(internacional)</span>}
                      </td>
                      <td class="px-3 py-[6px] text-subtle">{p.data_ida ? fmtDataCurta(p.data_ida) : "—"}</td>
                      <td class="px-4 py-[6px] text-ink text-right font-mono">{p.custo_efetivo != null ? fmtBRL(p.custo_efetivo) : "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}

        {viagens.diarias.length > 0 && (
          <details class="border-t border-border group">
            <summary class="px-4 py-[9px] text-[10px] font-semibold text-ink cursor-pointer select-none list-none flex items-center gap-[6px] hover:bg-card/50 transition-colors">
              <span class="text-subtle group-open:rotate-90 transition-transform inline-block">›</span>
              Ver diárias mais recentes (até 40 de {fmtNum(viagens.qtdDiarias)})
            </summary>
            <div class="overflow-x-auto border-t border-border">
              <table class="w-full text-[10px]" style="min-width: 560px">
                <thead>
                  <tr class="bg-card/50 border-b border-border text-left">
                    <th class="px-4 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Nome</th>
                    <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Cargo</th>
                    <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Motivo</th>
                    <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px] text-right">Qtd.</th>
                    <th class="px-4 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px] text-right">Valor</th>
                  </tr>
                </thead>
                <tbody>
                  {viagens.diarias.map((d) => (
                    <tr class="border-b border-border last:border-0">
                      <td class="px-4 py-[6px] text-ink">{d.nome ?? "—"}</td>
                      <td class="px-3 py-[6px] text-muted">{d.cargo ?? "—"}</td>
                      <td class="px-3 py-[6px] text-subtle line-clamp-1">{d.motivo ?? "—"}</td>
                      <td class="px-3 py-[6px] text-subtle text-right">{d.quantidade ?? "—"}</td>
                      <td class="px-4 py-[6px] text-ink text-right font-mono">{d.valor_total != null ? fmtBRL(d.valor_total) : "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}

        <p class="px-4 py-[8px] border-t border-border text-[9px] text-subtle leading-[1.5]">
          Fonte: portal de transparência do STF (painéis Passagens Aéreas e Diárias),
          {" "}desde {viagens.desde ?? "2016"}. Inclui o próprio {substantivo} e quem está
          lotado no gabinete — juízes convocados, assessores. Cada trecho voado (ida,
          volta) aparece como um registro separado.
        </p>
      </section>
    )}

    {controleConcentrado.total > 0 && (
      <section class="border border-border rounded-sm overflow-hidden mb-6">
        <div class="px-4 py-[9px] bg-card border-b border-border flex items-center justify-between gap-3">
          <h2 class="text-[9px] font-bold uppercase tracking-[1.5px] text-subtle">Controle concentrado</h2>
          <span class="text-[8.5px] text-subtle">ADI/ADC/ADPF/ADO desde 1997</span>
        </div>
        <div class="grid grid-cols-2 divide-x divide-border">
          <div class="px-4 py-[13px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Sob relatoria</div>
            <div class="text-[15px] font-bold text-ink">{fmtNum(controleConcentrado.total)}</div>
            <div class="text-[9px] text-subtle mt-[2px]">ações no total</div>
          </div>
          <div class="px-4 py-[13px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Em tramitação</div>
            <div class="text-[15px] font-bold text-ink">{fmtNum(controleConcentrado.emTramitacao)}</div>
            <div class="text-[9px] text-subtle mt-[2px]">ainda não baixadas</div>
          </div>
        </div>

        <details class="border-t border-border group">
          <summary class="px-4 py-[9px] text-[10px] font-semibold text-ink cursor-pointer select-none list-none flex items-center gap-[6px] hover:bg-card/50 transition-colors">
            <span class="text-subtle group-open:rotate-90 transition-transform inline-block">›</span>
            Ver ações mais recentes (até 40 de {fmtNum(controleConcentrado.total)})
          </summary>
          <div class="overflow-x-auto border-t border-border">
            <table class="w-full text-[10px]" style="min-width: 640px">
              <thead>
                <tr class="bg-card/50 border-b border-border text-left">
                  <th class="px-4 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Processo</th>
                  <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Ramo do direito</th>
                  <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Situação</th>
                  <th class="px-4 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Autuação</th>
                </tr>
              </thead>
              <tbody>
                {controleConcentrado.acoes.map((a) => (
                  <tr class="border-b border-border last:border-0">
                    <td class="px-4 py-[6px] text-ink">
                      {a.link_processo ? (
                        <a href={a.link_processo} target="_blank" rel="noopener" class="hover:underline">{a.processo}</a>
                      ) : a.processo}
                    </td>
                    <td class="px-3 py-[6px] text-muted">{a.ramo_direito ?? "—"}</td>
                    <td class="px-3 py-[6px] text-subtle">{a.situacao_processual ?? "—"}</td>
                    <td class="px-4 py-[6px] text-subtle">{a.data_autuacao ? fmtDataCurta(a.data_autuacao) : "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>

        <p class="px-4 py-[8px] border-t border-border text-[9px] text-subtle leading-[1.5]">
          Fonte: portal de transparência do STF (painel Corte Aberta — Controle Concentrado).
          {" "}Ações Diretas de Inconstitucionalidade, Declaratórias de Constitucionalidade,
          de Descumprimento de Preceito Fundamental e de Inconstitucionalidade por Omissão —
          atribuídas por sorteio ao distribuir, não por escolha do {substantivo}.
        </p>
      </section>
    )}

    {reclamacoes.total > 0 && (
      <section class="border border-border rounded-sm overflow-hidden mb-6">
        <div class="px-4 py-[9px] bg-card border-b border-border flex items-center justify-between gap-3">
          <h2 class="text-[9px] font-bold uppercase tracking-[1.5px] text-subtle">Reclamações</h2>
          <span class="text-[8.5px] text-subtle">histórico completo</span>
        </div>
        <div class="grid grid-cols-3 divide-x divide-border">
          <div class="px-4 py-[13px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Sob relatoria</div>
            <div class="text-[15px] font-bold text-ink">{fmtNum(reclamacoes.total)}</div>
            <div class="text-[9px] text-subtle mt-[2px]">reclamações no total</div>
          </div>
          <div class="px-4 py-[13px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Em tramitação</div>
            <div class="text-[15px] font-bold text-ink">{fmtNum(reclamacoes.emTramitacao)}</div>
            <div class="text-[9px] text-subtle mt-[2px]">ainda não baixadas</div>
          </div>
          <div class="px-4 py-[13px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Liminar pendente</div>
            <div class="text-[15px] font-bold text-ink">{fmtNum(reclamacoes.liminaresPendentes)}</div>
            <div class="text-[9px] text-subtle mt-[2px]">de decisão sobre liminar</div>
          </div>
        </div>

        <details class="border-t border-border group">
          <summary class="px-4 py-[9px] text-[10px] font-semibold text-ink cursor-pointer select-none list-none flex items-center gap-[6px] hover:bg-card/50 transition-colors">
            <span class="text-subtle group-open:rotate-90 transition-transform inline-block">›</span>
            Ver reclamações mais recentes (até 40 de {fmtNum(reclamacoes.total)})
          </summary>
          <div class="overflow-x-auto border-t border-border">
            <table class="w-full text-[10px]" style="min-width: 560px">
              <thead>
                <tr class="bg-card/50 border-b border-border text-left">
                  <th class="px-4 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Processo</th>
                  <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Ramo do direito</th>
                  <th class="px-3 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Procedência</th>
                  <th class="px-4 py-[7px] font-semibold text-subtle uppercase tracking-[0.5px] text-[9px]">Autuação</th>
                </tr>
              </thead>
              <tbody>
                {reclamacoes.lista.map((r) => (
                  <tr class="border-b border-border last:border-0">
                    <td class="px-4 py-[6px] text-ink">{r.processo}</td>
                    <td class="px-3 py-[6px] text-muted">{r.ramo_direito ?? "—"}</td>
                    <td class="px-3 py-[6px] text-subtle">{r.procedencia ?? "—"}</td>
                    <td class="px-4 py-[6px] text-subtle">{r.data_autuacao ? fmtDataCurta(r.data_autuacao) : "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>

        <p class="px-4 py-[8px] border-t border-border text-[9px] text-subtle leading-[1.5]">
          Fonte: portal de transparência do STF (painel Corte Aberta — Reclamações).
          {" "}Reclamação é o instrumento para forçar o cumprimento de uma decisão do STF
          por tribunais inferiores ou por atos do Poder Executivo — não julga o mérito do
          caso original, só se ele foi respeitado.
        </p>
      </section>
    )}

    {omissaoInconstitucional.length > 0 && (
      <section class="border border-border rounded-sm overflow-hidden mb-6">
        <div class="px-4 py-[9px] bg-card border-b border-border flex items-center justify-between gap-3">
          <h2 class="text-[9px] font-bold uppercase tracking-[1.5px] text-subtle">Omissão inconstitucional</h2>
          <span class="text-[8.5px] text-subtle">{fmtNum(omissaoInconstitucional.length)} caso{omissaoInconstitucional.length > 1 && "s"}</span>
        </div>
        {omissaoInconstitucional.map((c) => (
          <a
            href={c.link_processo ?? undefined}
            target={c.link_processo ? "_blank" : undefined}
            rel={c.link_processo ? "noopener" : undefined}
            class:list={["grid border-b border-border last:border-0 px-4 py-[9px] items-start gap-2", c.link_processo && "hover:bg-card/50 transition-colors"]}
            style="grid-template-columns: 74px 1fr 90px"
          >
            <span class="font-mono text-[9px] text-subtle pt-[1px]">{c.processo}</span>
            <div>
              <div class="text-[11px] text-ink font-medium leading-[1.35]">{c.materia ?? "—"}</div>
              <div class="text-[10px] text-subtle leading-[1.35] mt-[2px]">{c.ramo_direito ?? c.tipo_omissao ?? "—"}</div>
            </div>
            <span class="text-[9px] text-subtle text-right self-start justify-self-end">
              {c.data_julgamento ? fmtDataCurta(c.data_julgamento) : "—"}
            </span>
          </a>
        ))}
        <p class="px-4 py-[8px] border-t border-border text-[9px] text-subtle leading-[1.5]">
          Fonte: portal de transparência do STF (painel Corte Aberta — Omissão Inconstitucional).
          {" "}Lista curada de julgados em que o STF reconheceu falta de lei, política pública ou
          ato administrativo exigido pela Constituição — não é um recorte automático de processos.
        </p>
      </section>
    )}

    {perfil && segmentosNatureza.length > 0 && (
      <section class="border border-border rounded-sm overflow-hidden mb-6">
        <div class="px-4 py-[9px] bg-card border-b border-border flex items-center justify-between gap-3">
          <h2 class="text-[9px] font-bold uppercase tracking-[1.5px] text-subtle">Perfil decisório</h2>
          <span class="text-[8.5px] text-subtle">{fmtNum(perfil.totalDecisoes)} decisões classificadas por regra</span>
        </div>

        <div class="px-4 py-[13px]">
          <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-2">
            Natureza do ato — o que o ministro decidiu, não como decidiu
          </div>
          <div class="flex h-[10px] rounded-sm overflow-hidden border border-border2">
            {segmentosNatureza.map((s) => (
              <div
                class:list={[
                  "h-full",
                  s.chave === "merito" ? "bg-white" : "bg-border2",
                ]}
                style={`width:${s.pct}%`}
                title={`${s.rotulo}: ${s.pct}%`}
              />
            ))}
          </div>
          <div class="flex gap-x-4 gap-y-1 flex-wrap mt-2">
            {segmentosNatureza.map((s) => (
              <span class="text-[10px] text-muted flex items-center gap-[5px]">
                <span class:list={["w-[7px] h-[7px] rounded-sm inline-block", s.chave === "merito" ? "bg-white" : "bg-border2"]} />
                {s.rotulo} <span class="text-subtle">{s.pct}%</span>
              </span>
            ))}
          </div>
        </div>

        {segmentosSentido.length > 0 && (
          <div class="px-4 py-[13px] border-t border-border">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-2">
              Dentro do mérito ({fmtNum(perfil.nMeritoComSentido)} decisões) — resultado em relação ao pedido
            </div>
            <div class="flex h-[10px] rounded-sm overflow-hidden border border-border2">
              {segmentosSentido.map((s) => (
                <div
                  class:list={["h-full", s.chave === "favoravel" ? "bg-white" : s.chave === "contrario" ? "bg-border2" : "bg-subtle"]}
                  style={`width:${s.pct}%`}
                  title={`${s.rotulo}: ${s.pct}%`}
                />
              ))}
            </div>
            <div class="flex gap-x-4 gap-y-1 flex-wrap mt-2">
              {segmentosSentido.map((s) => (
                <span class="text-[10px] text-muted flex items-center gap-[5px]">
                  <span class:list={["w-[7px] h-[7px] rounded-sm inline-block", s.chave === "favoravel" ? "bg-white" : s.chave === "contrario" ? "bg-border2" : "bg-subtle"]} />
                  {s.rotulo} <span class="text-subtle">{s.pct}%</span>
                </span>
              ))}
            </div>
          </div>
        )}

        <div class="grid grid-cols-2 divide-x divide-border border-t border-border">
          <div class="px-4 py-[10px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Estilo de atuação</div>
            <div class="text-[11px] text-muted">
              {perfil.pctMonocratica !== null
                ? <>{perfil.pctMonocratica}% monocrática · {perfil.pctColegiada}% colegiada</>
                : "—"}
            </div>
          </div>
          <div class="px-4 py-[10px]">
            <div class="text-[9px] font-semibold uppercase tracking-[1px] text-subtle mb-1">Tempo médio até a decisão</div>
            <div class="text-[11px] text-muted">
              {perfil.tempoMedioDias !== null ? `${fmtNum(perfil.tempoMedioDias)} dias desde a autuação` : "—"}
            </div>
          </div>
        </div>

        <div class="px-4 py-[10px] border-t border-border bg-card/50">
          <p class="text-[10px] text-muted leading-[1.55]">
            <strong class="font-semibold text-ink">Classificação por regra, não por IA.</strong>
            {" "}"Favorável"/"contrário" é o resultado literal que o STF escreveu (provido, negado
            provimento, etc.) em relação ao que foi pedido — não uma leitura de mérito substantivo
            nem de lado político. "Negado seguimento"/"não conhecido" (admissibilidade) nunca conta
            como "contrário": são coisas diferentes. Escopo: decisões monocráticas como relator
            nomeado — exclui decisões institucionais da Presidência e colegiadas.
            <a href="/metodologia#perfil-decisorio" class="underline hover:text-ink ml-1">Metodologia completa</a>
            {" · "}
            <a href="/ministros/comparativo" class="underline hover:text-ink">Comparar com outros ministros</a>
          </p>
        </div>
      </section>
    )}

    <section class="border border-border rounded-sm overflow-hidden">
      <div class="px-4 py-[9px] bg-card border-b border-border flex items-center justify-between gap-3">
        <h2 class="text-[9px] font-bold uppercase tracking-[1.5px] text-subtle">
          Decisões monocráticas como relator
          {total > 0 && <span class="ml-2 font-normal normal-case tracking-normal text-subtle">{fmtNum(total)} no total</span>}
        </h2>
        {decisoes[0] && <span class="text-[8.5px] text-subtle">dados até {fmtData(decisoes[0].data_decisao)}</span>}
      </div>

      {comoPresidente > 0 && (
        <div class="px-4 py-[10px] border-b border-border bg-card/50">
          <p class="text-[10px] text-muted leading-[1.55]">
            <strong class="font-semibold text-ink">Fora desta lista:</strong>
            {" "}{fmtNum(comoPresidente)} decisões assinadas na condição de presidente do STF —
            plantão e competência da Presidência, não a pauta do ministro como relator.
          </p>
        </div>
      )}

      {decisoes.length === 0 && (
        <p class="px-4 py-5 text-[11px] text-subtle text-center">
          Sem decisões monocráticas registradas como relator
        </p>
      )}

      {decisoes.map((d) => (
        <article class="grid border-b border-border last:border-0 px-4 py-[9px] items-start gap-2"
                 style="grid-template-columns: 74px 1fr 150px">
          <time class="font-mono text-[9px] text-subtle pt-[1px]" datetime={d.data_decisao}>
            {fmtDataCurta(d.data_decisao)}
          </time>
          <div>
            <div class="text-[11px] text-muted leading-[1.35] line-clamp-2">{d.assunto ?? "—"}</div>
            <div class="font-mono text-[8.5px] text-subtle mt-[2px]">
              {d.processo}{d.tipo_decisao && <span class="ml-2 opacity-60">{d.tipo_decisao}</span>}
            </div>
          </div>
          <div class="text-[9px] text-subtle leading-[1.3] text-right">{d.andamento_bruto}</div>
        </article>
      ))}
    </section>

    <p class="text-[10px] text-subtle mt-4 max-w-2xl leading-[1.6]">
      O andamento aparece exatamente como o STF o registrou. A leitura agregada de
      favorável/contrário acima (quando existe) segue metodologia publicada e por
      regra — nunca inferência de IA sobre o conteúdo do caso.
      <a href="/metodologia" class="underline hover:text-ink ml-1">Como lemos os dados</a>
    </p>
  </div>
</Base>
