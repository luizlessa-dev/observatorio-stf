---
/**
 * Casca de toda página. Achado E4: o SPA tinha um único <title> e uma única
 * <meta description> para as oito rotas, sem canonical, sem Open Graph e sem
 * JSON-LD. Aqui cada página declara os seus.
 */
import "../estilos/global.css";

interface Props {
  titulo: string;
  descricao: string;
  caminho: string;          // "/ministros/gilmar-mendes"
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  imagemOg?: string;        // caminho absoluto ou relativo da og:image; default: /og/padrao.png
  feedRss?: string;         // caminho do RSS pra autodiscovery, só nas páginas de /casos
}

const { titulo, descricao, caminho, jsonLd, imagemOg, feedRss } = Astro.props;
const ORIGEM = "https://observatoriodostf.org";
const canonical = new URL(caminho, ORIGEM).href;
const imagemOgAbsoluta = new URL(imagemOg ?? "/og/padrao.png", ORIGEM).href;

const NAV = [
  { href: "/",                  rotulo: "Ministros" },
  { href: "/casos",             rotulo: "Casos" },
  { href: "/decisoes",          rotulo: "Decisões" },
  { href: "/repercussao-geral", rotulo: "Repercussão Geral" },
];
const atual = Astro.url.pathname;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- AUD-08: era @import no CSS, que só dispara depois do CSS principal
         carregar e parsear (uma volta de rede a mais antes mesmo de começar a
         buscar a fonte). Link + preconnect no head deixa o navegador abrir a
         conexão com fonts.googleapis.com/gstatic.com em paralelo ao HTML. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Observatório do STF" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagemOgAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemOgAbsoluta} />

    {feedRss && (
      <link rel="alternate" type="application/rss+xml" title="Observatório do STF — Casos" href={new URL(feedRss, ORIGEM).href} />
    )}

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>

  <body class="min-h-screen bg-canvas text-ink">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-canvas focus:text-[12px] focus:font-semibold focus:px-4 focus:py-2 focus:rounded-sm"
    >
      Pular para o conteúdo
    </a>

    <div class="bg-card border-b border-border text-center py-[7px] px-6 text-[11px] text-muted">
      <strong class="text-ink font-semibold">Projeto independente.</strong>{" "}
      Sem vínculo com o Governo Federal. Dados de fontes públicas oficiais.
    </div>

    <header class="bg-canvas border-b border-border px-8 flex items-center justify-between h-[62px]">
      <a href="/" class="flex items-center gap-3 no-underline">
        <svg width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true">
          <line x1="18" y1="4"  x2="18" y2="30" stroke="#f2f0e9" stroke-width="1.2" />
          <line x1="10" y1="30" x2="26" y2="30" stroke="#f2f0e9" stroke-width="1.5" stroke-linecap="round" />
          <line x1="7"  y1="10" x2="29" y2="10" stroke="#f2f0e9" stroke-width="1.2" />
          <line x1="9"  y1="10" x2="9"  y2="16" stroke="#f2f0e9" stroke-width="1" />
          <line x1="27" y1="10" x2="27" y2="16" stroke="#f2f0e9" stroke-width="1" />
          <path d="M5 16 Q9 19 13 16" stroke="#f2f0e9" stroke-width="1" fill="none" stroke-linecap="round" />
          <path d="M23 17.5 Q27 20.5 31 17.5" stroke="#f2f0e9" stroke-width="1" fill="none" stroke-linecap="round" />
          <circle cx="18" cy="4" r="1.4" fill="#f2f0e9" />
        </svg>
        <div>
          <div class="font-display text-[15px] font-bold text-white leading-none">Observatório do STF</div>
          <div class="text-[8.5px] text-subtle uppercase tracking-[1.5px] mt-[2px]">judiciário às claras</div>
        </div>
      </a>

      <nav class="hidden md:flex" aria-label="Principal">
        {NAV.map(({ href, rotulo }) => {
          const ativo = href === "/" ? atual === "/" || atual.startsWith("/ministros") : atual.startsWith(href);
          return (
            <a
              href={href}
              aria-current={ativo ? "page" : undefined}
              class:list={[
                "px-[13px] h-[62px] flex items-center text-[12px] font-medium border-b-2 transition-colors",
                ativo ? "text-white border-white" : "text-muted border-transparent hover:text-ink",
              ]}
            >{rotulo}</a>
          );
        })}
      </nav>

      <div class="hidden md:flex items-center gap-2">
        <a href="/assinar" class="text-[11px] font-semibold text-canvas bg-white px-[14px] py-[6px] rounded-sm hover:bg-white/90 transition-colors">Apoiar</a>
        <a href="/entrar" class="text-[12px] font-semibold text-ink border border-border2 rounded-sm px-[14px] py-[6px] hover:border-white/20 transition-colors">Entrar</a>
      </div>

      <details id="menu-mobile" class="md:hidden relative">
        <summary
          class="list-none cursor-pointer flex items-center justify-center w-9 h-9 -mr-1"
          aria-label="Abrir menu"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <line x1="2" y1="5"  x2="18" y2="5"  stroke="#f2f0e9" stroke-width="1.5" stroke-linecap="round" />
            <line x1="2" y1="10" x2="18" y2="10" stroke="#f2f0e9" stroke-width="1.5" stroke-linecap="round" />
            <line x1="2" y1="15" x2="18" y2="15" stroke="#f2f0e9" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="absolute right-0 top-[calc(100%+1px)] w-60 bg-card border border-border rounded-sm shadow-lg py-2 z-50">
          <nav class="flex flex-col" aria-label="Principal (móvel)">
            {NAV.map(({ href, rotulo }) => {
              const ativo = href === "/" ? atual === "/" || atual.startsWith("/ministros") : atual.startsWith(href);
              return (
              <a
                href={href}
                aria-current={ativo ? "page" : undefined}
                class:list={[
                  "px-4 py-[10px] text-[13px] font-medium transition-colors",
                  ativo ? "text-white" : "text-muted hover:text-ink",
                ]}
              >{rotulo}</a>
              );
            })}
          </nav>
          <div class="flex flex-col gap-2 px-4 pt-2 mt-2 border-t border-border">
            <a href="/assinar" class="text-[12px] font-semibold text-canvas bg-white px-[14px] py-[8px] rounded-sm text-center">Apoiar</a>
            <a href="/entrar" class="text-[12px] font-semibold text-ink border border-border2 rounded-sm px-[14px] py-[8px] text-center">Entrar</a>
          </div>
        </div>
      </details>
    </header>

    <script>
      // Fecha o menu mobile ao clicar num link interno ou fora do <details>.
      const menu = document.getElementById("menu-mobile") as HTMLDetailsElement | null;
      if (menu) {
        menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => { menu.open = false; }));
        document.addEventListener("click", (evento) => {
          if (menu.open && !menu.contains(evento.target as Node)) menu.open = false;
        });
      }
    </script>

    <main id="conteudo" tabindex="-1"><slot /></main>

    <footer class="border-t border-border mt-16 px-8 py-8 text-[11px] text-subtle">
      <div class="flex flex-wrap gap-x-6 gap-y-2 mb-4">
        <a href="/sobre" class="hover:text-ink transition-colors">Sobre</a>
        <a href="/metodologia" class="hover:text-ink transition-colors">Metodologia</a>
        <a href="/termos" class="hover:text-ink transition-colors">Termos de Uso</a>
        <a href="/privacidade" class="hover:text-ink transition-colors">Privacidade</a>
        <a href="mailto:luiz@thebrinsider.com" class="hover:text-ink transition-colors">Contato e direito de resposta</a>
        <a href="/casos/rss.xml" class="hover:text-ink transition-colors">RSS</a>
      </div>
      <p class="max-w-2xl leading-[1.6]">
        Observatório do STF é um projeto editorial independente, sem vínculo com o
        Supremo Tribunal Federal ou com o Governo Federal. Os dados vêm de fontes
        públicas oficiais e cada tela informa até quando o dado vai.
      </p>
    </footer>
  </body>
</html>
