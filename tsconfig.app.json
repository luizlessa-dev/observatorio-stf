{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] }
  },
  // Achado D3: `api/` — onde vivem checkout.ts e webhook.ts, o código que
  // move dinheiro — ficava fora do typecheck. Foi por isso que o problema de
  // `current_period_end` (campo que saiu do objeto Subscription na versão de
  // API declarada) não apareceu em nenhuma verificação local.
  "include": ["src", "api"]
}
